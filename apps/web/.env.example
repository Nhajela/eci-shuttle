# Copy to apps/web/.env.local for dev. No secrets in this file.
PUBLIC_ORIGIN=http://localhost:3000
# docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://postgres:postgres@localhost:5548/shuttle
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# random, >= 16 chars; sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# random, >= 32 chars
SESSION_SECRET=
# comma-separated, >= 32 chars each; first one seals new tokens
TOKEN_SECRETS=
# optional
EXPO_ACCESS_TOKEN=
# optional IST date (YYYY-MM-DD): the cleanup job deletes ALL raw pings from this date on, including that day itself
# (the event ends 1 Nov, so use 2026-11-02 or later); unset = never delete
# PINGS_DELETE_AFTER=2026-11-02
# optional: Postgres connections per process (web and worker each get their own pool). Default 10 for web; the
# worker image (ROLE=worker, start.sh) defaults to 20 because its job locks hold up to 8 connections for their
# whole run. Budget: web + worker (+ the one-off migrate on deploy) must stay under Postgres max_connections.
# DB_POOL_MAX=10
