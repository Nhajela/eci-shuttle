# Copy to apps/web/.env.local for dev. No secrets in this file.
PUBLIC_ORIGIN=http://localhost:3000
# docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://postgres:postgres@localhost:5548/shuttle
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# random, >= 16 chars; sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# random, >= 32 chars
SESSION_SECRET=
# comma-separated, >= 32 chars each; first one seals new tokens
TOKEN_SECRETS=
# optional
EXPO_ACCESS_TOKEN=
# optional IST date (YYYY-MM-DD): the last day whose raw pings are kept. The nightly cleanup (03:30 IST) deletes
# ALL raw pings from the day after this date on (set 2026-11-01 for an event ending 1 Nov: the purge runs on 2 Nov).
# Unset = never delete. The purge is one audit row (pings.purge) and cannot be undone.
# PINGS_DELETE_AFTER=2026-11-01
